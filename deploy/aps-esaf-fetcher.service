[Unit]
Description=APS ESAF Fetcher — ESAF database and web service
After=network.target

[Service]
Type=simple
User=chem_epics
WorkingDirectory=/opt/aps-esaf-fetcher
EnvironmentFile=/etc/aps-esaf-fetcher/secrets.env
ExecStart=/opt/aps-esaf-fetcher/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8088 \
    --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
