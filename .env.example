# Copy to .env and fill in real values. Never commit .env.
DM_USERNAME=your_aps_username
DM_PASSWORD=your_aps_password
DM_URL=https://catdtn03.aps.anl.gov:11337

# Station and beamlines to sync (beamlines pipe-separated)
STATION_ID=CHMCARS
BEAMLINE_NAMES=15-ID-C,D
# Years to sync (comma-separated). Leave empty for current year + previous year.
SYNC_YEARS=

# How often to auto-sync (hours). 0 = disable auto-sync.
SYNC_INTERVAL_HOURS=24

# Database path
DB_PATH=/home/chem_epics/.aps-esaf-fetcher/esaf.db

# Server bind
HOST=0.0.0.0
PORT=8088
